# =============================================================================
# Polymarket BTC 5m strategy lab — environment template
# Copy: cp .env.example .env   then fill in what you need. Never commit .env.
# Everything has a sensible default; with an empty .env the bot paper-trades all strategies.
# =============================================================================

# -----------------------------------------------------------------------------
# Simulation (paper trading) — the default mode
# -----------------------------------------------------------------------------
# Starting bankroll for each simulated strategy.
SIM_BANKROLL_USD=100
# Delay between a decision and its simulated fill (taker orders fill against the book this much later).
SIM_LATENCY_MS=400
# Which strategies to run: "all", or a comma list of ids:
#   naive-favorite, conservative, maker-patient, balanced, aggressive, degen, adaptive
SIM_STRATEGIES=all
# Record raw market data to logs/recordings/YYYY-MM-DD.jsonl for backtesting (~100 MB/day).
RECORD_DATA=true
# RECORDINGS_DIR=./logs/recordings
# SIM_STATE_FILE=./logs/sim_state.json
# SIM_TRADES_CSV=./logs/sim_trades.csv

# -----------------------------------------------------------------------------
# Data quality guards
# -----------------------------------------------------------------------------
# Prices older than these are treated as missing and no decisions are made.
MAX_CHAINLINK_AGE_MS=5000
MAX_BINANCE_AGE_MS=3000
MAX_BOOK_AGE_MS=3000
# Price-to-beat = first Chainlink tick stamped within this window after the round starts.
PTB_LATCH_TOLERANCE_MS=3000

# -----------------------------------------------------------------------------
# Learning
# -----------------------------------------------------------------------------
LEARNER_LR=0.05
LEARNER_L2=0.01
# Training samples: one every N seconds over the last M seconds of each round.
LEARNER_SAMPLE_EVERY_SEC=15
LEARNER_SAMPLE_WINDOW_SEC=240

# -----------------------------------------------------------------------------
# Live trading (off by default). The live bot mirrors ONE simulated strategy.
# -----------------------------------------------------------------------------
ENABLE_LIVE_TRADING=false
# Strategy to mirror with real orders (taker strategies only).
LIVE_STRATEGY=conservative
# Live orders only start once that strategy has at least this many settled sim bets AND positive sim P&L.
LIVE_MIN_SIM_BETS=200
# Hard cap per live order, regardless of the strategy's sizing.
MAX_LIVE_STAKE_USD=5
# Stop placing live orders for the rest of the UTC day after this much realized loss.
DAILY_LOSS_LIMIT_USD=25
# FAK = fill what's available up to the worst price; FOK = all or nothing.
MARKET_ORDER_TYPE=FAK
DEBUG_LIVE_TRADING=false

# Wallet private key for signing CLOB orders (0x… hex). Only needed for live trading.
PRIVATE_KEY=
# Polymarket proxy / smart wallet that holds USDC (your Polymarket "funder" address).
POLYMARKET_FUNDER_ADDRESS=
# CLOB signature type: 0=EOA, 1=POLY_PROXY, 2=GNOSIS_SAFE (typical for Polymarket UI wallets).
POLY_SIGNATURE_TYPE=2
# Polygon RPC used to read the wallet's USDC balance.
# POLYGON_RPC_URL=https://polygon-rpc.com
# USDC_ADDRESS=0x2791Bca1f2de4661ED88A30C99A7a9449Aa84174

# -----------------------------------------------------------------------------
# Market selection
# -----------------------------------------------------------------------------
# Leave empty to follow the live 5m round automatically.
POLYMARKET_SLUG=
POLYMARKET_SERIES_ID=10684
POLYMARKET_AUTO_SELECT_LATEST=true
POLYMARKET_LIVE_WS_URL=wss://ws-live-data.polymarket.com
POLYMARKET_UP_LABEL=Up
POLYMARKET_DOWN_LABEL=Down
# BINANCE_SYMBOL=btcusdt

# -----------------------------------------------------------------------------
# Loop timing
# -----------------------------------------------------------------------------
# TICK_MS=1000
# BOOK_POLL_MS=1000
# MARKET_POLL_MS=5000

# -----------------------------------------------------------------------------
# Console & dashboard
# -----------------------------------------------------------------------------
QUIET_CONSOLE=false
DASHBOARD_PORT=3000
# Bind address. Keep 127.0.0.1 and use an SSH tunnel on servers; 0.0.0.0 exposes it to the network.
DASHBOARD_HOST=127.0.0.1
# Optional: required (Bearer token) for POST /api/sim-reset.
# DASHBOARD_SECRET=

# -----------------------------------------------------------------------------
# HTTP proxy (optional — undici global dispatcher + WS agents)
# -----------------------------------------------------------------------------
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890
# ALL_PROXY=socks5://127.0.0.1:1080
