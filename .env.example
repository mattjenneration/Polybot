# =============================================================================
# Polymarket BTC 5m strategy lab — environment template
# Copy: cp .env.example .env   then fill in what you need. Never commit .env.
# Everything has a sensible default; with an empty .env the bot paper-trades all strategies.
# =============================================================================

# -----------------------------------------------------------------------------
# Simulation (paper trading) — the default mode
# -----------------------------------------------------------------------------
# Starting bankroll for each simulated strategy.
SIM_BANKROLL_USD=100
# Delay between a decision and its simulated fill (taker orders fill against the book this much later).
SIM_LATENCY_MS=400
# Which strategies to run: "all", or a comma list of ids:
#   naive-favorite, conservative, maker-patient, balanced, aggressive, degen, adaptive
SIM_STRATEGIES=all
# Record raw market data to logs/recordings/YYYY-MM-DD.jsonl for backtesting (~100 MB/day).
RECORD_DATA=true
# RECORDINGS_DIR=./logs/recordings
# SIM_STATE_FILE=./logs/sim_state.json
# SIM_TRADES_CSV=./logs/sim_trades.csv

# -----------------------------------------------------------------------------
# Data quality guards
# -----------------------------------------------------------------------------
# Prices older than these are treated as missing and no decisions are made.
MAX_CHAINLINK_AGE_MS=5000
MAX_BINANCE_AGE_MS=3000
MAX_BOOK_AGE_MS=3000
# Price-to-beat = first Chainlink tick stamped within this window after the round starts.
PTB_LATCH_TOLERANCE_MS=3000

# -----------------------------------------------------------------------------
# Learning
# -----------------------------------------------------------------------------
LEARNER_LR=0.05
LEARNER_L2=0.01
# Training samples: one every N seconds over the last M seconds of each round.
LEARNER_SAMPLE_EVERY_SEC=15
LEARNER_SAMPLE_WINDOW_SEC=240

# -----------------------------------------------------------------------------
# Live trading (off by default). The live bot mirrors ONE simulated strategy.
# -----------------------------------------------------------------------------
ENABLE_LIVE_TRADING=false
# Strategy to mirror with real orders (taker strategies only).
LIVE_STRATEGY=conservative
# Live orders only start once that strategy has at least this many settled sim bets AND positive sim P&L.
LIVE_MIN_SIM_BETS=200
# Hard cap per live order, regardless of the strategy's sizing.
MAX_LIVE_STAKE_USD=5
# Stop placing live orders for the rest of the UTC day after this much realized loss.
DAILY_LOSS_LIMIT_USD=25
# FAK = fill what's available up to the worst price; FOK = all or nothing.
MARKET_ORDER_TYPE=FAK
DEBUG_LIVE_TRADING=false

# Wallet private key for signing CLOB orders (0x… hex). Only needed for live trading.
PRIVATE_KEY=
# Polymarket proxy / smart wallet that holds USDC (your Polymarket "funder" address).
POLYMARKET_FUNDER_ADDRESS=
# CLOB signature type: 0=EOA, 1=POLY_PROXY, 2=GNOSIS_SAFE (typical for Polymarket UI wallets).
POLY_SIGNATURE_TYPE=2
# Polygon RPC used to read the wallet's USDC balance.
# POLYGON_RPC_URL=https://polygon-rpc.com
# USDC_ADDRESS=0x2791Bca1f2de4661ED88A30C99A7a9449Aa84174

# -----------------------------------------------------------------------------
# Market selection
# -----------------------------------------------------------------------------
# Leave empty to follow the live 5m round automatically.
POLYMARKET_SLUG=
POLYMARKET_SERIES_ID=10684
POLYMARKET_AUTO_SELECT_LATEST=true
POLYMARKET_LIVE_WS_URL=wss://ws-live-data.polymarket.com
POLYMARKET_UP_LABEL=Up
POLYMARKET_DOWN_LABEL=Down
# BINANCE_SYMBOL=btcusdt

# -----------------------------------------------------------------------------
# Loop timing
# -----------------------------------------------------------------------------
# TICK_MS=1000
# BOOK_POLL_MS=1000
# MARKET_POLL_MS=5000

# -----------------------------------------------------------------------------
# Console & dashboard
# -----------------------------------------------------------------------------
QUIET_CONSOLE=false
DASHBOARD_PORT=3000
# Bind address. Keep 127.0.0.1 and use an SSH tunnel on servers; 0.0.0.0 exposes it to the network.
DASHBOARD_HOST=127.0.0.1
# Optional: required (Bearer token) for POST /api/sim-reset.
# DASHBOARD_SECRET=

# -----------------------------------------------------------------------------
# HTTP proxy (optional — undici global dispatcher + WS agents)
# -----------------------------------------------------------------------------
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890
# ALL_PROXY=socks5://127.0.0.1:1080

# -----------------------------------------------------------------------------
# Multi-market paper simulator (npm run sim:markets / pm2 app "markets-sim")
# Crypto price ladders (Deribit-implied). Temperature markets have their own trader (see below).
# Scorecard vs BTC 5m: npm run report:markets [-- --hours 24]
# Taker fees come from each market's Gamma feeSchedule via src/core/fees.js, same as BTC 5m.
# -----------------------------------------------------------------------------
# MARKETS_MODULES=crypto_ladder
# MARKETS_LOOP_SECONDS=60
# MARKETS_BUDGET_USD=1000          # paper bankroll per module
# MARKETS_BET_USD=10               # spend per position incl. fees
# MARKETS_MAX_OPEN_POSITIONS=60    # per module
# MARKETS_MAX_POSITIONS_PER_EVENT=3
# MARKETS_SNAPSHOT_MINUTES=15      # calibration log cadence per market
# CRYPTO_LADDER_MIN_EDGE=0.06      # model prob − (ask + fee)
# CRYPTO_LADDER_ASSETS=BTC,ETH,SOL,XRP
# CRYPTO_LADDER_TAGS=crypto        # Gamma tag slugs to scan
# CRYPTO_LADDER_MAX_DAYS=35
# CRYPTO_LADDER_MIN_MINUTES_TO_EXPIRY=15

# -----------------------------------------------------------------------------
# Weather trader — daily high/low temperature markets (npm run sim:weather / pm2 app "weather-sim")
# Paper only. Dashboard: /weather.html. Report: npm run report:weather. Logs: logs/weather/.
# Forecasts: Open-Meteo multi-model + ensembles. Observations: METAR (aviationweather.gov), Hong Kong Observatory.
# History: Open-Meteo previous runs + IEM METAR archive (auto-backfilled per station on first sight).
# -----------------------------------------------------------------------------
# Learning mode: shadow variants explore and every learner updates from settled events. false = frozen.
# WEATHER_LEARNING_MODE=true
# WEATHER_BANKROLL_USD=1000            # paper bankroll per visible strategy
# WEATHER_STRATEGIES=all               # or: market-favorite,nowcast-sniper,forecast-taker,maker-bidder,tail-fader,model-only,learning
# WEATHER_CITIES=                      # empty = every city; else titles' names, e.g. NYC,London,Hong Kong
# WEATHER_KINDS=high,low
# WEATHER_MIN_EVENTS=15                # settled events a variant/city needs before its record counts
# WEATHER_LCB_Z=1.0                    # how many standard errors above zero a variant must be to be "proven"
# WEATHER_BACKFILL_DAYS=45
# WEATHER_AUTO_BACKFILL=true
# WEATHER_SHADOW_STAKE_USD=1
# WEATHER_MAX_EVENT_EXPOSURE_PCT=0.06  # per strategy, of equity
# WEATHER_MAX_OPEN_EXPOSURE_PCT=0.6
# WEATHER_RECORD_SNAPSHOTS=true        # hourly per-event JSONL in logs/weather/snapshots (~9 MB/day)
# WEATHER_TICK_SECONDS=30
# WEATHER_FORECAST_MINUTES=60
# WEATHER_ENSEMBLE_MINUTES=180
# WEATHER_MODELS=ecmwf_ifs025,ecmwf_aifs025_single,gfs_seamless,icon_seamless,gem_seamless,jma_seamless,meteofrance_seamless,ukmo_seamless,cma_grapes_global,ncep_nbm_conus,knmi_seamless,metno_seamless
# WEATHER_ENSEMBLE_MODELS=ecmwf_ifs025,gfs025,icon_seamless
# WEATHER_LOG_DIR=./logs/weather
# Open-Meteo's free API is for non-commercial use; a key switches to the customer endpoints.
# OPEN_METEO_API_KEY=
